# LOCAL variant of the OTel image (for the maintainer's own setup).
#
# Same self-contained build as ./Dockerfile. It exists so the
# docker-compose.local.yml stack can point the services at RabbitMQ / Redis /
# Jaeger that already run on your own external `shared_net` network (started
# from a separate infra stack), instead of the services bundled in
# docker-compose.yml.
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache

COPY . .

CMD ["uv", "run", "uvicorn", "publisher.main:app", "--host", "0.0.0.0", "--port", "8000"]
